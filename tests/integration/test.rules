# Integration test policy: the spec's example rule file (section 4, item 2)
# in our syntax. out = initiated from the inside, in = from the outside.
allow out tcp  from 10.0.1.0/24 to any port 80
allow out tcp  from 10.0.1.0/24 to any port 443
allow out udp  from 10.0.1.0/24 to any port 53
allow out icmp from 10.0.1.0/24 to any
allow in  tcp  from any to 10.0.1.3 port 22
# anything not matched is denied
